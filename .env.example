# Copy this file to .env and fill in real values. Never commit .env.

# Deepgram (STT + TTS) — https://deepgram.com
DEEPGRAM_API_KEY=

# Groq (LLM brain, used as a BYOM think-provider through Deepgram) — https://console.groq.com
GROQ_API_KEY=

# Optional: WebSocket port the relay listens on for the browser client
RELAY_PORT=8787

# Optional: Android device-control layer (a separate MCP server driving ADB
# against a phone). Omit both to run voice-only, with device control disabled.
WINDOWS_MCP_URL=
WINDOWS_MCP_TOKEN=
